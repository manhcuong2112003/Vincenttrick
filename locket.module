#!name=Locket Gold & 30s Video
#!desc=Mở khóa Locket Gold VIP, Video 30s, Theme Gold & Khung Hoàng Gia cho app Locket App Store.
#!author=Vincent
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Locket.png

[Rule]
DOMAIN,appattest.apple.com,REJECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaselogging.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
# 1. Xóa ETag / If-None-Match (dùng setHeaderValue = "") để ép RevenueCat & Firebase luôn trả về HTTP 200
deleteHeader = type=http-request,pattern=^https?:\/\/((api|rc-cdn|sdk)\.revenuecat\.com|revenuecat\.com|firebaseremoteconfig\.googleapis\.com)\/.+,script-path=https://vincenttrick.pages.dev/deleteHeader.js,timeout=60

# 2. Mở khóa toàn bộ API RevenueCat (Subscribers, Receipts, Offerings, Product Mapping trên cả api & rc-cdn)
revenuecat = type=http-response,pattern=^https?:\/\/((api|rc-cdn|sdk)\.revenuecat\.com|revenuecat\.com)\/.+\/(receipts|subscribers|product_entitlement_mapping).*,script-path=https://vincenttrick.pages.dev/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

# 3. Mở khóa toàn bộ 1,014 cờ Firebase Remote Config (Feature Gates, Flag 30s, Theme Gold, Khung Hoàng Gia)
locketFirebase = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://vincenttrick.pages.dev/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60



# 4. Proxy request generateFilteredImage thẳng sang Cloudflare Worker bất kể Locket gọi domain nào
aiFilterProxy = type=http-request,pattern=^https?:\/\/.*cloudfunctions\.net\/generateFilteredImage.*,script-path=https://vincenttrick.pages.dev/aiFilterProxy.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, revenuecat.com, rc-cdn.revenuecat.com, sdk.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, *cloudfunctions.net
