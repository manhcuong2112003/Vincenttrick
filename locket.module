#!name=Locket Gold & 30s Video
#!desc=Đồng bộ 100% cơ chế Server Uplocket: 160 quyền VIP, 1014 cờ Firebase, Theme Gold, Khung Hoàng Gia & Video 30s.
#!author=Vincent

[Rule]
DOMAIN,appattest.apple.com,REJECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaselogging.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
# 1. Xóa ETag / If-None-Match (dùng setHeaderValue = "") để ép RevenueCat & Firebase luôn trả về HTTP 200
deleteHeader = type=http-request,pattern=^https?:\/\/((api|rc-cdn|sdk)\.revenuecat\.com|revenuecat\.com|firebaseremoteconfig\.googleapis\.com)\/.+,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/deleteHeader.js,timeout=60

# 2. Mở khóa toàn bộ API RevenueCat (Subscribers, Receipts, Offerings, Product Mapping trên cả api & rc-cdn)
revenuecat = type=http-response,pattern=^https?:\/\/((api|rc-cdn|sdk)\.revenuecat\.com|revenuecat\.com)\/.+\/(receipts|subscribers|product_entitlement_mapping).*,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

# 3. Mở khóa toàn bộ 1,014 cờ Firebase Remote Config (Feature Gates, Flag 30s, Theme Gold, Khung Hoàng Gia)
locketFirebase = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://raw.githubusercontent.com/manhcuong2112003/Locket_by_Vincent/main/locket_gold_30s.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, revenuecat.com, rc-cdn.revenuecat.com, sdk.revenuecat.com, firebaseremoteconfig.googleapis.com
